{
  "name": "visto-gallery",
  "version": "0.3.3",
  "description": "A fast, local-first photo & video gallery app for macOS",
  "private": true,
  "license": "MIT",
  "author": "Devendra Kumar",
  "repository": {
    "type": "git",
    "url": "https://github.com/Davin-X/visto-gallery.git"
  },
  "homepage": "https://github.com/Davin-X/visto-gallery#readme",
  "bugs": {
    "url": "https://github.com/Davin-X/visto-gallery/issues"
  },
  "keywords": [
    "macOS",
    "photo-gallery",
    "local-first",
    "tauri",
    "rust",
    "react",
    "vite",
    "exif"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "test": "vitest run",
    "benchmark:library": "node scripts/benchmark-library-harness.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "screenshots": "node scripts/capture-all-screenshots.mjs",
    "prepare": "sh scripts/setup-hooks.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "exifr": "^7.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.5.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
